# --- Supabase ---
# URL y Service Role Key del proyecto de Supabase (Project Settings > API).
# La Service Role Key es secreta: ignora Row Level Security y NUNCA debe
# usarse en el frontend. Acá, en el backend, es justamente lo que permite
# hacer las operaciones de escritura del CRUD después de validar todo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Servidor ---
PORT=3001
# Orígenes permitidos por CORS, separados por coma (sin espacios finales).
# En producción, agregar acá la URL pública del frontend en Vercel.
CLIENT_ORIGIN=http://localhost:5173

# --- Email transaccional (opcional) ---
# Si se dejan vacías, el formulario de contacto sigue funcionando y
# guardando los mensajes en Supabase; simplemente no se envía el email
# de notificación. Se completan con una cuenta de Resend (resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# URL base del backend (Express). En desarrollo local apunta al servidor
# corriendo con `npm run dev` dentro de /Back. En producción (Vercel), si el
# backend se despliega como otro proyecto de Vercel, poner aquí su URL pública
# (por ejemplo https://r4-portfolio-back.vercel.app). El código antepone este
# valor a cada ruta /api/... — ver src/lib/apiClient.js.
VITE_API_URL=http://localhost:3001
